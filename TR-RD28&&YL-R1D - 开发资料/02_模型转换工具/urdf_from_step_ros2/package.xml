<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>urdf_from_step_ros2</name>
  <version>0.0.1</version>
  <description>The urdf_from_step_ros2 package – converts STEP files to URDF models</description>

  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>BSD</license>

  <!-- ROS2 构建工具 -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 运行时依赖（ROS2 核心） -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- 如果你的节点使用了 launch 文件，可能需要 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Python 第三方包（建议通过 pip 安装，但也可列出） -->
  <!-- 注意：rosdep 可能不识别这些，仅作文档 -->
  <!-- <exec_depend>tf_transformations</exec_depend> -->
  <!-- <exec_depend>urdf_parser_py</exec_depend> -->
  <!-- <exec_depend>pythonocc-core</exec_depend> -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>